# Pinned versions of the native (no-Docker) server stack. One line per component:
#   <name>=<github repo>@<release tag or full commit SHA>:<asset prefix>
# The asset downloaded is "<asset prefix>-<os>-<arch>" (e.g. mautrix-whatsapp-darwin-arm64) and is checked
# against the SHA-256 pinned for it in sha256sums.txt beside this file, never the release's own.
# AFTER ANY CHANGE HERE RUN native/pin-hashes.sh (and commit its sha256sums.txt): ManifestTest fails the build
# until every file this can install is pinned. Config changes between versions are handled in setup-mac.sh.
whatsapp=mautrix/whatsapp@v0.2610.0:mautrix-whatsapp
telegram=mautrix/telegram@v0.2610.0:mautrix-telegram
signal=mautrix/signal@v0.2610.0:mautrix-signal
# Instagram: mautrix-meta v0.2607.0 is the last release whose Instagram mode works for us (same as Docker).
instagram=mautrix/meta@v0.2607.0:mautrix-instagram
facebook=mautrix/meta@v0.2610.0:mautrix-meta
# Discord: v0.7.7 plus native/patches/discord/resume-subscribe-pace.patch (built by Unichat, NATIVES_ALL below). On
# every resume it subscribed to all guilds at once; Discord closes that with 4008 "Rate limited" and the bridge resumed
# and subscribed again, in a loop. The patch paces it 2 s per guild, as the bridge's connect path does.
discord=mautrix/discord@v0.7.7:mautrix-discord
slack=mautrix/slack@v0.2610.0:mautrix-slack
gmessages=mautrix/gmessages@v0.2610.0:mautrix-gmessages
# X: since 2026-11-19 X encrypts messages under per-message keys, which v0.2609.0 can't read. Pinned to the head of
# mautrix/twitter PR #257 (on top of main 77b2290), not released yet, so built by Unichat (NATIVES_ALL below). Back to
# a release tag once one includes it.
twitter=mautrix/twitter@8d47b077e0e943d94e2c2c2fcda62f864ef781c1:mautrix-twitter
linkedin=mautrix/linkedin@v0.2609.0:mautrix-linkedin

# Homeserver: no official macOS/Windows builds, so it is built from source (see setup-mac.sh).
TUWUNEL_VERSION=v1.9.4

# What Unichat builds itself (.github/workflows/natives.yml): the homeserver for both platforms, the bridges for
# Windows, where mautrix publishes none, and those in NATIVES_ALL for every platform, with their patches
# (native/patches/<bridge>/*.patch). Bump the tag whenever a version above or a patch changes, and run that workflow.
NATIVES=vaoan/unichat@natives-2
# Built by Unichat on macOS too (from NATIVES, not mautrix's release): patched, or at a commit with no release.
NATIVES_ALL=twitter,discord
# Not built for Windows yet: Signal's Rust part (libsignal) fails to link with Go there.
NATIVES_UNBUILT=signal
