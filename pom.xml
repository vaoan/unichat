<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>app.unichat</groupId>
  <artifactId>unichat</artifactId>
  <version>1.3.1</version>
  <name>Unichat</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>27.0.1</javafx.version>
    <jackson.version>2.17.2</jackson.version>
    <main.class>app.unichat.Launcher</main.class>
    <!-- Names each build run (SpotBugsCache's decision file): to the millisecond, a valid file name everywhere. -->
    <maven.build.timestamp.format>yyyyMMdd-HHmmss-SSS</maven.build.timestamp.format>
    <!-- The headless-ui profile sets it; surefire adds the temp folder to it. -->
    <argLine></argLine>
  </properties>

  <!-- InstaTray's download engine (instatray.core: sites, per-site cookies, yt-dlp/gallery-dl): the user's own library,
       built by JitPack from the tag. Only that artifact comes from there. -->
  <repositories>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.github.vaoan</groupId>
      <artifactId>InstaTray</artifactId>
      <version>core-1.0.2</version>
    </dependency>
    <dependency>
      <!-- Argon2id for the vault's password key (the JDK has none). -->
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.87</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.14.0</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-web</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <!-- QR codes of the bridges' login steps (WhatsApp, Signal, Telegram, Google Messages). -->
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
    </dependency>
    <dependency>
      <!-- Bridge config.yaml files of the native server (app.unichat.server). -->
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <!-- WebP decoding (WhatsApp stickers are animated WebP); JavaFX can't read WebP. -->
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>3.12.0</version>
    </dependency>
    <dependency>
      <!-- Reads the user's own Firefox cookies.sqlite (loaded through JDBC DriverManager). -->
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
    <!-- Pure-Java H.264/MP4 encoder: animated stickers sent to WhatsApp as GIF or video (BSD-2). -->
    <dependency>
      <groupId>org.jcodec</groupId>
      <artifactId>jcodec-javase</artifactId>
      <version>0.2.5</version>
    </dependency>
    <!-- Pure-Java Opus decoder: voice notes (Ogg/Opus) decoded to WAV for local Whisper transcription (BSD-3). -->
    <dependency>
      <groupId>io.github.jaredmdobson</groupId>
      <artifactId>concentus</artifactId>
      <version>1.0.2</version>
    </dependency>
    <dependency>
      <!-- Reads message HTML as a browser would: what bridges write is often badly nested. -->
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.3</version>
    </dependency>
    <dependency>
      <!-- @SuppressModernizer, for the one place java.io is needed (support/MarkOfTheWeb). Compile time only. -->
      <groupId>org.gaul</groupId>
      <artifactId>modernizer-maven-annotations</artifactId>
      <version>3.5.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- @SuppressFBWarnings, for a SpotBugs finding kept on purpose with its justification. Compile time only. -->
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>4.10.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The package rules of docs/ARCHITECTURE.md, checked by ArchitectureTest. -->
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.4.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>unichat</finalName>
    <!-- Only version.properties is filtered (AppVersion reads it): the other resources stay byte for byte. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>app/unichat/version.properties</exclude></excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>app/unichat/version.properties</include></includes>
      </resource>
    </resources>
    <!-- The lifecycle's own plugins, pinned at the versions Maven 3.10.0 brought by default (requirePluginVersions). -->
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.2.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-deploy-plugin</artifactId><version>3.2.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-site-plugin</artifactId><version>3.22.0</version></plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Every javac lint is an error, in main and test code alike (BuildRulesTest keeps it on). A category may be
           turned off only with -Xlint:-name and the reason beside it. -->
      <!-- Error Prone runs inside javac on main and test code; -Werror makes its warnings errors too (.mvn/jvm.config
           opens javac to it). Besides its defaults, checks that are off by default and catch real defects are on.
           Off, each one noise here (BuildRulesTest wants every :OFF named in this comment):
           StringSplitter: 58 sites read, none depends on trailing empty parts (each takes the first, checks the
             length, skips blanks or reads lines); the fix needs Guava, not a dependency.
           ReferenceEquality: JavaFX code compares nodes, windows and sentinels by identity on purpose (57 found, all meant).
           Off by default and left so, each with what it found here:
           InterruptedExceptionSwallowed: flags every JUnit test that "throws Exception" (345); its 19 main-code sites
             are parked as a follow-up, because restoring the interrupt there changes behaviour.
           AddNullMarkedToClass, FieldMissingNullable, ParameterMissingNullable, ReturnMissingNullable,
             ReturnsNullCollection: nullness is NullAway's, Task 7 (ParameterMissingNullable also crashes 2.53.0).
           Interruption: Thread.interrupt() is how workers are cancelled here (7, all meant).
           NonFinalStaticField: UI-thread caches and test seams on purpose (25); making them final is a redesign.
           SystemExitOutsideMain: Recovery's restart must exit the JVM.
           SystemOut: stdout and stderr are the log (AppLog writes them to unichat.log).
           Java8ApiChecker: the code targets Java 25.
           CanIgnoreReturnValueSuggester: suggests Google's annotation, which the code doesn't use.
           RemoveUnusedImports: Checkstyle's (Task 5).
           CatchingUnchecked, ThrowsUncheckedException, ConstantPatternCompile, PreferJavaTimeOverload,
             UnnecessaryBoxedVariable, MethodCanBeStatic: speed or how to say it, not defects.
           TraditionalJavadocToMarkdown, MissingBraces, UnnecessarilyFullyQualified, Varifier, Var, BooleanParameter,
             MultiVariableDeclaration, YodaCondition, UngroupedOverloads, InconsistentOverloads, WildcardImport,
             IdentifierName, MissingJavadoc, ImmutableMemberCollection, TooManyParameters, PreferredInterfaceType,
             UnnecessaryAnonymousClass, AvoidObjectArrays: a style the code doesn't use, not defects.
           Every other off-by-default check found nothing in main code. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne -Xep:NullableOptional:ERROR -Xep:FieldCanBeFinal:ERROR -Xep:UnnecessaryDefaultInEnumSwitch:ERROR -Xep:UnusedException:ERROR -Xep:UseEnumSwitch:ERROR -Xep:DefaultLocale:ERROR -Xep:EqualsBrokenForNull:ERROR -Xep:TimeUnitMismatch:ERROR -Xep:PrimitiveArrayPassedToVarargsMethod:ERROR -Xep:ComparisonContractViolated:ERROR -Xep:TransientMisuse:ERROR -Xep:VoidUsed:ERROR -Xep:AssertFalse:ERROR -Xep:TypeToString:ERROR -Xep:IterablePathParameter:ERROR -Xep:FunctionalInterfaceClash:ERROR -Xep:LongLiteralLowerCaseSuffix:ERROR -Xep:DepAnn:ERROR -Xep:StringSplitter:OFF -Xep:ReferenceEquality:OFF</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>2.53.0</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- The build's own rules: the JDK and Maven it needs, one version of each library, every plugin pinned, no
           snapshots, no dependency cycles. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <dependencies>
          <dependency>
            <!-- banCircularDependencies. -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <version>1.12.1</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>enforce</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9.0,)</version></requireMavenVersion>
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
                <requirePluginVersions>
                  <banLatest>true</banLatest>
                  <banRelease>true</banRelease>
                  <banSnapshots>true</banSnapshots>
                </requirePluginVersions>
                <requireReleaseDeps/>
                <banCircularDependencies/>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Legacy APIs that have a modern replacement at the project's Java (Vector, new Date(), Guava the JDK has). -->
      <plugin>
        <groupId>org.gaul</groupId>
        <artifactId>modernizer-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <javaVersion>${maven.compiler.release}</javaVersion>
          <failOnViolations>true</failOnViolations>
          <includeTestClasses>true</includeTestClasses>
        </configuration>
        <executions>
          <execution>
            <id>modernizer</id>
            <!-- Once the classes are compiled, before the tests: a finding fails in seconds, not after the run. -->
            <phase>process-test-classes</phase>
            <goals><goal>modernizer</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <!-- Tests' temp files under target, emptied when the run ends (app.unichat.TestTemp): in the system's temp
               folder they stayed for good. On the command line, as the JDK reads java.io.tmpdir once at start. -->
          <argLine>@{argLine} -Djava.io.tmpdir=${project.build.directory}/test-tmp</argLine>
          <systemPropertyVariables>
            <!-- Keep tests away from the real user data folder. -->
            <unichat.dataDir>${project.build.directory}/test-data</unichat.dataDir>
            <unichat.autosaveDir>${project.build.directory}/test-autosave</unichat.autosaveDir>
            <!-- Tests read the Spanish texts, whatever the machine's language. -->
            <unichat.language>es</unichat.language>
            <!-- No sounds through the speakers. -->
            <unichat.silent>true</unichat.silent>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- File and method size limits (checkstyle.xml), checked on every build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- PMD, two checks in verify. cpd-check: copied code, failing at the plugin's default of 100 tokens (main code).
           check: every Java category of PMD (pmd-rules.xml, where each rule left out has its reason) on main and test
           code; any finding fails, at every priority. A finding kept on purpose is one line's "// NOPMD: why" or one
           member's @SuppressWarnings("PMD.Rule") // why (SuppressionsHaveReasonsTest). The analysis cache keeps a
           second run to the files that changed. BuildRulesTest keeps all of this on. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <dependencies>
          <dependency><groupId>net.sourceforge.pmd</groupId><artifactId>pmd-core</artifactId><version>7.29.0</version></dependency>
          <dependency><groupId>net.sourceforge.pmd</groupId><artifactId>pmd-java</artifactId><version>7.29.0</version></dependency>
          <dependency><groupId>net.sourceforge.pmd</groupId><artifactId>pmd-javascript</artifactId><version>7.29.0</version></dependency>
          <dependency><groupId>net.sourceforge.pmd</groupId><artifactId>pmd-jsp</artifactId><version>7.29.0</version></dependency>
        </dependencies>
        <configuration>
          <targetJdk>25</targetJdk>
          <printFailingErrors>true</printFailingErrors>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals><goal>cpd-check</goal></goals>
          </execution>
          <execution>
            <id>pmd</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rulesets><ruleset>pmd-rules.xml</ruleset></rulesets>
              <includeTests>true</includeTests>
              <analysisCache>true</analysisCache>
              <failOnViolation>true</failOnViolation>
              <failurePriority>5</failurePriority>
              <!-- A file PMD can't read fails the build; the plugin's default skips it silently. -->
              <skipPmdError>false</skipPmdError>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- SpotBugs reads the compiled classes, main and test, for bugs (nulls, resources left open, threads) and, with
           FindSecBugs, security (injection, weak crypto, paths). Effort Max, every confidence (threshold Low); any finding
           fails the build. spotbugs-exclude.xml leaves out only patterns that are noise here, each with its reason; a
           finding kept on purpose is one member's @SuppressFBWarnings with its justification. BuildRulesTest keeps it on. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.10.5.0</version>
        <dependencies>
          <!-- SpotBugs itself, pinned (4.10 reads Java 25's class files). -->
          <dependency><groupId>com.github.spotbugs</groupId><artifactId>spotbugs</artifactId><version>4.10.5</version></dependency>
        </dependencies>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <failOnError>true</failOnError>
          <!-- Its own JVM: room for effort Max, and one GC thread and two compiler threads, which take a third of the
               CPU off it (measured: 231 s user to 156 s, the same wall time; SpotBugs analyses on one thread). -->
          <maxHeap>2048</maxHeap>
          <jvmArgs>-XX:+UseSerialGC -XX:CICompilerCount=2</jvmArgs>
          <!-- The tests too: they add about 5 s to the 80 s of main code. -->
          <includeTests>true</includeTests>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin><groupId>com.h3xstream.findsecbugs</groupId><artifactId>findsecbugs-plugin</artifactId><version>1.14.0</version></plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- SpotBugs' one allowed skip, a repeat of a run that passed (it has no cache of its own: a minute each build).
           Before it, app.unichat.build.SpotBugsCache (test code, SpotBugsCacheTest) hashes all it reads (the classes, the
           tests' classes, this pom, spotbugs-exclude.xml, the libraries, the JDK) and writes spotbugs.skip, true only
           when that hash is the one marked after its last pass, in a file named after this run (maven.build.timestamp), so
           a run whose check didn't run finds none and stops; properties-maven-plugin reads it into the build. After
           SpotBugs, in verify, the hash is marked: a run that fails never is. BuildRulesTest keeps it to exactly this. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>spotbugs-inputs</id>
            <phase>post-integration-test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>app.unichat.build.SpotBugsCache</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>check</argument><argument>${project.basedir}</argument><argument>${maven.build.timestamp}</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>spotbugs-passed</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>app.unichat.build.SpotBugsCache</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>passed</argument><argument>${project.basedir}</argument><argument>${maven.build.timestamp}</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
        <version>1.4.0</version>
        <executions>
          <execution>
            <id>spotbugs-decision</id>
            <phase>post-integration-test</phase>
            <goals><goal>read-project-properties</goal></goals>
            <configuration>
              <files><file>${project.build.directory}/spotbugs-cache/skip-${maven.build.timestamp}.properties</file></files>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>
      <!-- Fat jar for jpackage; JavaFX natives match the OS that runs the build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Keeps ImageIO plugin registrations (META-INF/services) of all jars in the fat jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- UI tests with no display and no windows: ./mvnw verify -Pheadless-ui, on JavaFX's own headless platform (25+). -->
    <profile>
      <id>headless-ui</id>
      <properties>
        <argLine>-Dunichat.uiTests=true -Dunichat.headless=true -Dglass.platform=Headless -Dprism.order=sw -Djava.awt.headless=true</argLine>
      </properties>
    </profile>
  </profiles>
</project>
