<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>app.unichat</groupId>
  <artifactId>unichat</artifactId>
  <version>1.1.0</version>
  <name>Unichat</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>27.0.1</javafx.version>
    <jackson.version>2.17.2</jackson.version>
    <main.class>app.unichat.Launcher</main.class>
  </properties>

  <!-- InstaTray's download engine (instatray.core: sites, per-site cookies, yt-dlp/gallery-dl): the user's own library,
       built by JitPack from the tag. Only that artifact comes from there. -->
  <repositories>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.github.vaoan</groupId>
      <artifactId>InstaTray</artifactId>
      <version>core-1.0.1</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.14.0</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-web</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <!-- QR codes of the bridges' login steps (WhatsApp, Signal, Telegram, Google Messages). -->
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
    </dependency>
    <dependency>
      <!-- Bridge config.yaml files of the native server (app.unichat.server). -->
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <!-- WebP decoding (WhatsApp stickers are animated WebP); JavaFX can't read WebP. -->
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>3.12.0</version>
    </dependency>
    <dependency>
      <!-- Reads the user's own Firefox cookies.sqlite (loaded through JDBC DriverManager). -->
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
    <!-- Pure-Java H.264/MP4 encoder: animated stickers sent to WhatsApp as GIF or video (BSD-2). -->
    <dependency>
      <groupId>org.jcodec</groupId>
      <artifactId>jcodec-javase</artifactId>
      <version>0.2.5</version>
    </dependency>
    <!-- Pure-Java Opus decoder: voice notes (Ogg/Opus) decoded to WAV for local Whisper transcription (BSD-3). -->
    <dependency>
      <groupId>io.github.jaredmdobson</groupId>
      <artifactId>concentus</artifactId>
      <version>1.0.2</version>
    </dependency>
    <dependency>
      <!-- Reads message HTML as a browser would: what bridges write is often badly nested. -->
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.3</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The package rules of docs/ARCHITECTURE.md, checked by ArchitectureTest. -->
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.4.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>unichat</finalName>
    <!-- Only version.properties is filtered (AppVersion reads it): the other resources stay byte for byte. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>app/unichat/version.properties</exclude></excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>app/unichat/version.properties</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <systemPropertyVariables>
            <!-- Keep tests away from the real user data folder. -->
            <unichat.dataDir>${project.build.directory}/test-data</unichat.dataDir>
            <unichat.autosaveDir>${project.build.directory}/test-autosave</unichat.autosaveDir>
            <!-- Tests read the Spanish texts, whatever the machine's language. -->
            <unichat.language>es</unichat.language>
            <!-- No sounds through the speakers. -->
            <unichat.silent>true</unichat.silent>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- File and method size limits (checkstyle.xml), checked on every build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- Copied code: fails the build at the plugin's default of 100 tokens. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.26.0</version>
        <configuration>
          <printFailingErrors>true</printFailingErrors>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals><goal>cpd-check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>
      <!-- Fat jar for jpackage; JavaFX natives match the OS that runs the build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Keeps ImageIO plugin registrations (META-INF/services) of all jars in the fat jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- UI tests with no display and no windows: ./mvnw verify -Pheadless-ui, on JavaFX's own headless platform (25+). -->
    <profile>
      <id>headless-ui</id>
      <properties>
        <argLine>-Dunichat.uiTests=true -Dunichat.headless=true -Dglass.platform=Headless -Dprism.order=sw -Djava.awt.headless=true</argLine>
      </properties>
    </profile>
  </profiles>
</project>
