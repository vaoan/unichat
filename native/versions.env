# Pinned versions of the native (no-Docker) server stack. One line per component:
#   <name>=<github repo>@<release tag>:<asset prefix>
# The asset downloaded is "<asset prefix>-<os>-<arch>" (e.g. mautrix-whatsapp-darwin-arm64) and is checked
# against the release's sha256sums.txt. Bumping a version here is the whole update for that bridge;
# config changes between versions are handled in setup-mac.sh.
whatsapp=mautrix/whatsapp@v0.2610.0:mautrix-whatsapp
telegram=mautrix/telegram@v0.2610.0:mautrix-telegram
signal=mautrix/signal@v0.2610.0:mautrix-signal
# Instagram: mautrix-meta v0.2607.0 is the last release whose Instagram mode works for us (same as Docker).
instagram=mautrix/meta@v0.2607.0:mautrix-instagram
facebook=mautrix/meta@v0.2610.0:mautrix-meta
discord=mautrix/discord@v0.7.7:mautrix-discord
slack=mautrix/slack@v0.2610.0:mautrix-slack
gmessages=mautrix/gmessages@v0.2610.0:mautrix-gmessages
twitter=mautrix/twitter@v0.2609.0:mautrix-twitter
linkedin=mautrix/linkedin@v0.2609.0:mautrix-linkedin

# Homeserver: no official macOS/Windows builds, so it is built from source (see setup-mac.sh).
TUWUNEL_VERSION=v1.9.4
