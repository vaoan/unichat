index 0000000..fe2cfa3
--- /dev/null
+++ b/pkg/connector/commands_test.go
@@ -0,0 +1,22 @@
+// Unichat's patch: tests for sync-history-chats' argument.
+
+package connector
+
+import (
+	"strconv"
+	"testing"
+)
+
+func TestParseHistoryChatsLimit(t *testing.T) {
+	for _, args := range [][]string{{"0"}, {"501"}, {"abc"}, {"-1"}, {"1.5"}, {}, {"100", "1"}} {
+		if n, ok := parseHistoryChatsLimit(args); ok {
+			t.Errorf("parseHistoryChatsLimit(%q) = %d, want refused", args, n)
+		}
+	}
+	for _, want := range []int{1, 100, 500} {
+		args := []string{strconv.Itoa(want)}
+		if n, ok := parseHistoryChatsLimit(args); !ok || n != want {
+			t.Errorf("parseHistoryChatsLimit(%q) = %d, %v, want %d, true", args, n, ok, want)
+		}
+	}
+}
