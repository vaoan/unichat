 }
 
+// Unichat's patch: rooms for older chats the history sync stored but didn't bridge, on request.
+var cmdSyncHistoryChats = &commands.FullHandler{
+	Func: fnSyncHistoryChats,
+	Name: "sync-history-chats",
+	Help: commands.HelpMeta{
+		Section:     commands.HelpSectionChats,
+		Description: "Create rooms for the most recent chats from the history sync that don't have one yet.",
+		Args:        "<1-500>",
+	},
+	RequiresLogin: true,
+}
+
+const maxHistoryChats = 500
+
+// parseHistoryChatsLimit reads sync-history-chats' only argument: a whole number from 1 to maxHistoryChats.
+func parseHistoryChatsLimit(args []string) (int, bool) {
+	if len(args) != 1 {
+		return 0, false
+	}
+	n, err := strconv.Atoi(args[0])
+	if err != nil || n < 1 || n > maxHistoryChats {
+		return 0, false
+	}
+	return n, true
+}
+
+func fnSyncHistoryChats(ce *commands.Event) {
+	login := ce.User.GetDefaultLogin()
+	if login == nil {
+		ce.Reply("Login not found")
+		return
+	}
+	limit, ok := parseHistoryChatsLimit(ce.Args)
+	if !ok {
+		ce.Reply("Usage: `$cmdprefix sync-history-chats <1-%d>`", maxHistoryChats)
+		return
+	} else if !login.Client.IsLoggedIn() {
+		ce.Reply("Not logged in")
+		return
+	}
+	wa := login.Client.(*WhatsAppClient)
+	// The bridge's own context, not the command's: the rooms are created after the reply.
+	created := wa.createPortalsFromHistorySync(ce.Bridge.BackgroundCtx, limit)
+	ce.Reply("Created %d chats from history sync", created)
+}
