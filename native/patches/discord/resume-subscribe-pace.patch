+		}
 		guild := user.bridge.GetGuildByID(guildMeta.ID, false)
 		if guild != nil && guild.MXID != "" {
 			user.log.Debug().Str("guild_id", guild.ID).Msg("Subscribing to guild")
@@ -846,7 +866,7 @@ func (user *User) subscribeGuilds(delay time.Duration) {
